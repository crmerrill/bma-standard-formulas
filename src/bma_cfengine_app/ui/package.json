{
  "name": "bma-cfengine-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run --testNamePattern=a11y",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:ux": "npm run test && npm run test:e2e",
    "sync:field-order": "cp ../../../bma_standard_formulas/deals/schemas/field_order.json ./src/features/deals/field_order.json"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "zustand": "^5.0.6",
    "zundo": "^2.3.0",
    "blockly": "^12.5.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "recharts": "^2.15.3",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.5",
    "axe-core": "^4.11.4",
    "jsdom": "^29.1.0",
    "msw": "^2.14.6",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.4",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
